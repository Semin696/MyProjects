      "type": "wokwi-text",
      "id": "t4",
      "top": 170,
      "left": 560,
      "attrs": {
        "text": "контакты реле:\nP1 = COM (общий)\nNO1 = нормально разомкнутый\nNC1 = нормально замкнутый"
      }
    },
    {
      "type": "wokwi-text",
